{
  "info": {
    "name": "Team Task Tracker API",
    "description": "SDE II Take-Home Assignment — Full API collection for the Team Task Tracker. Run Register first to get tokens, then use the access_token automatically via the collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080/api/v1" },
    { "key": "access_token",  "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "org_id",        "value": "" },
    { "key": "user_id",       "value": "" },
    { "key": "project_id",    "value": "" },
    { "key": "task_id",       "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Create Org + ADMIN)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.collectionVariables.set('access_token',  r.access_token);",
                "pm.collectionVariables.set('refresh_token', r.refresh_token);",
                "pm.collectionVariables.set('org_id',        r.user.organization_id);",
                "pm.collectionVariables.set('user_id',       r.user.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"password123\",\n  \"org_name\": \"Acme Corp\"\n}"
            }
          }
        },
        {
          "name": "Register (Join Org as MEMBER)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Team Member\",\n  \"email\": \"member@acme.com\",\n  \"password\": \"password123\",\n  \"org_id\": \"{{org_id}}\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.collectionVariables.set('access_token',  r.access_token);",
                "pm.collectionVariables.set('refresh_token', r.refresh_token);",
                "pm.test('Status 200', () => pm.response.to.have.status(200));"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "pm.collectionVariables.set('access_token',  r.access_token);",
                "pm.collectionVariables.set('refresh_token', r.refresh_token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User (me)",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/me"
          }
        },
        {
          "name": "List Org Members (for assignee picker)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/members"
          }
        },
        {
          "name": "List All Users (ADMIN only)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Update User Role (ADMIN only)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/users/{{user_id}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MANAGER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project (ADMIN/MANAGER)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.id) pm.collectionVariables.set('project_id', r.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Backend API\",\n  \"description\": \"Core REST API project\",\n  \"start_date\": \"2026-06-01T00:00:00Z\",\n  \"end_date\": \"2026-08-31T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/projects"
          }
        },
        {
          "name": "Delete Project (ADMIN only)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/projects/{{project_id}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task (ADMIN/MANAGER)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.id) pm.collectionVariables.set('task_id', r.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"title\": \"Implement login endpoint\",\n  \"description\": \"POST /auth/login with JWT response\",\n  \"priority\": \"HIGH\",\n  \"assignee_ids\": [\"{{user_id}}\"],\n  \"due_date\": \"2026-12-31T23:59:59Z\"\n}"
            }
          }
        },
        {
          "name": "List Tasks (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks?page=1&limit=20",
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Tasks (filter by status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks?status=IN_PROGRESS&priority=HIGH",
              "query": [
                { "key": "status",   "value": "IN_PROGRESS" },
                { "key": "priority", "value": "HIGH" }
              ]
            }
          }
        },
        {
          "name": "List Tasks (filter by assignee)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks?assignee_id={{user_id}}",
              "query": [
                { "key": "assignee_id", "value": "{{user_id}}" }
              ]
            }
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/{{task_id}}"
          }
        },
        {
          "name": "Update Task (ADMIN/MANAGER)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement login endpoint (updated)\",\n  \"description\": \"Updated description\",\n  \"priority\": \"MEDIUM\",\n  \"assignee_ids\": [\"{{user_id}}\"],\n  \"due_date\": \"2026-12-31T23:59:59Z\"\n}"
            }
          }
        },
        {
          "name": "Update Status → IN_PROGRESS",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Update Status → IN_REVIEW",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_REVIEW\"\n}"
            }
          }
        },
        {
          "name": "Update Status → DONE",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}"
            }
          }
        },
        {
          "name": "Update Status → BLOCKED",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BLOCKED\"\n}"
            }
          }
        },
        {
          "name": "Delete Task (ADMIN only)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/tasks/{{task_id}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/tasks/{{task_id}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Starting work on this. Will update by EOD.\"\n}"
            }
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/{{task_id}}/comments"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "http://localhost:8080/health"
          }
        }
      ]
    }
  ]
}